<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sk.drabik</groupId>
		<artifactId>gigsynchub</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>gigsynchub-calendar</artifactId>
	<name>gigsynchub-calendar</name>
	<description>The band calendar: reading it, sorting events with the band's rules, changes, and bringing gigs into the catalog.</description>
	<dependencies>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-gig</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-accounts</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-places</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-sync</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-catalog</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-accounts</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-gig</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-sync</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-catalog</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- the tests' database: PostgreSQL in Docker (jdbc:tc: URL) -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<!-- the API this module serves: src/main/openapi/calendar.yaml → sk.drabikp.gigsynchub.calendar.adapter.in.rest.api -->
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>api</id>
						<configuration>
							<inputSpec>${project.basedir}/src/main/openapi/calendar.yaml</inputSpec>
							<apiPackage>sk.drabikp.gigsynchub.calendar.adapter.in.rest.api</apiPackage>
							<modelPackage>sk.drabikp.gigsynchub.calendar.adapter.in.rest.api</modelPackage>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
