<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>sk.drabik</groupId>
		<artifactId>gigsynchub</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>gigsynchub-app</artifactId>
	<name>gigsynchub-app</name>
	<description>The runnable application: wiring, configuration, the Vaadin theme.</description>
	<dependencies>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-gig</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-accounts</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-places</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-sync</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-catalog</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-importing</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-check</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-calendar</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-bandzone</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-bandsintown</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-live</artifactId>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-frontend</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<!-- the sign-in: OpenID Connect with Rauthy -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<!-- Metrics in the format Prometheus scrapes (/actuator/prometheus). Runtime: nothing
			     written here names it; it is a format the registry learns, not an API. -->
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<!-- Traces: Micrometer's Observation API (which Spring Boot already instruments: every
			     HTTP request, every scheduled run) bridged onto OpenTelemetry and sent on as OTLP,
			     which Tempo, Jaeger and every hosted backend take — the app knows no vendor.
			     THE STARTER, not the bridge and the exporter by hand: Spring Boot 4 broke the
			     actuator's autoconfiguration into modules, so picking the libraries yourself gets
			     you a classpath that looks right, a Tracer bean that is Tracer.NOOP, and not one
			     word of complaint. The missing piece was spring-boot-micrometer-tracing-opentelemetry,
			     which this brings along with the rest. -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<!-- The checks the specs' own limits generate (jakarta.validation annotations on every
			     generated request class and parameter, pom.xml useBeanValidation). The annotations
			     come with the kernel; this is the implementation that ENFORCES them, and without it
			     on the classpath a maxLength in a spec is a comment. -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>sk.drabik</groupId>
			<artifactId>gigsynchub-gig</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- ArchitectureTest: the slices' rules, checked on the compiled classes -->
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- jMolecules' own ArchUnit rules: what the annotations claim is checked, not just written -->
		<dependency>
			<groupId>org.jmolecules.integrations</groupId>
			<artifactId>jmolecules-archunit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- the tests' database: PostgreSQL in Docker (jdbc:tc: URL) -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<properties>
		<spring-boot.run.skip>false</spring-boot.run.skip>
	</properties>
	<build>
		<plugins>
			<plugin>
				<!-- the API this module serves: src/main/openapi/auth.yaml → sk.drabikp.gigsynchub.web.api -->
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>api</id>
						<configuration>
							<inputSpec>${project.basedir}/src/main/openapi/auth.yaml</inputSpec>
							<apiPackage>sk.drabikp.gigsynchub.web.api</apiPackage>
							<modelPackage>sk.drabikp.gigsynchub.web.api</modelPackage>
						</configuration>
					</execution>
					<execution>
						<!-- src/main/openapi/bands.yaml (a band's data as a whole) → sk.drabikp.gigsynchub.bands.api -->
						<id>bands-api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/openapi/bands.yaml</inputSpec>
							<apiPackage>sk.drabikp.gigsynchub.bands.api</apiPackage>
							<modelPackage>sk.drabikp.gigsynchub.bands.api</modelPackage>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- ./data, ./calendar etc. are relative to the repository root, not this module -->
					<workingDirectory>${project.basedir}/..</workingDirectory>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
