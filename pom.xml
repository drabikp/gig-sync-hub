<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>sk.drabik</groupId>
	<artifactId>gigsynchub</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>gigsynchub</name>
	<description>Gig sync hub: one band's gig catalog, kept in sync with listing platforms.</description>

	<!-- Vertical slices: one module per feature (features/), each with its own domain, application
	     (use cases + ports) and adapters; gig is the shared kernel. Platforms plug into the features'
	     ports (platforms/); app wires everything and runs. -->
	<modules>
		<module>features/gig</module>
		<module>features/accounts</module>
		<module>features/places</module>
		<module>features/sync</module>
		<module>features/catalog</module>
		<module>features/importing</module>
		<module>features/check</module>
		<module>features/calendar</module>
		<module>platforms/portal</module>
		<module>platforms/bandzone</module>
		<module>platforms/bandsintown</module>
		<module>web/live</module>
		<module>web/frontend</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<!-- H2 now only reads the old database's SQL backup for the one-time import into
		     PostgreSQL (gigsynchub.db.import-h2); pinned to the version that wrote it. -->
		<h2.version>2.4.240</h2.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<!-- jMolecules: the DDD and hexagonal concepts as annotations. Marker jars (jmolecules-ddd
		     brings only jstereotype, itself markers) with nothing at runtime, so the domain stays a
		     plain Java model that happens to say what each type IS. -->
		<jmolecules.bom.version>2025.0.2</jmolecules.bom.version>
		<!-- only the app module runs (spring-boot:run) -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-gig</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-gig</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-live</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-frontend</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-accounts</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-accounts</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-places</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-sync</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-sync</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-catalog</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-catalog</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-importing</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-check</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-calendar</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-portal</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-portal</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-bandzone</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>gigsynchub-bandsintown</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>1.4.2</version>
			</dependency>
			<dependency>
				<groupId>org.jmolecules</groupId>
				<artifactId>jmolecules-bom</artifactId>
				<version>${jmolecules.bom.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.22.1</version>
			</dependency>
			<dependency>
				<groupId>com.opencsv</groupId>
				<artifactId>opencsv</artifactId>
				<version>5.12.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Every module: what a type IS (aggregate, value object, repository, port, adapter) is said
	     on the type itself. Annotations only - no runtime, no transitive dependencies - and
	     ArchitectureTest's "the domain depends on the JDK and domain code" admits exactly these. -->
	<dependencies>
		<dependency>
			<groupId>org.jmolecules</groupId>
			<artifactId>jmolecules-ddd</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jmolecules</groupId>
			<artifactId>jmolecules-hexagonal-architecture</artifactId>
		</dependency>
	</dependencies>

	<profiles>
		<!--
			Known vulnerabilities in what this app depends on: `./mvnw -Psecurity verify`. A profile
			and not part of the build, for one reason — it downloads the NVD's whole database the
			first time (and wants an API key to do it at any speed, GIGSYNCHUB_NVD_API_KEY here),
			which is minutes on a machine whose job is to run the tests. It is for before a release
			and for a quiet afternoon, not for every push; Dependabot is what watches day to day.
		-->
		<profile>
			<id>security</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<version>12.1.3</version>
						<configuration>
							<nvdApiKey>${env.GIGSYNCHUB_NVD_API_KEY}</nvdApiKey>
							<!-- 7.0 is "high": below that is a reading list, not a finding -->
							<failBuildOnCVSS>7</failBuildOnCVSS>
							<!-- the page's own dependencies are audited by npm (see the workflow) -->
							<skipProvidedScope>false</skipProvidedScope>
							<formats>
								<format>HTML</format>
								<format>JSON</format>
							</formats>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>aggregate</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<pluginManagement>
			<plugins>
				<!-- MapStruct writes the mappers between the API's classes and the domain (…Mapper interfaces):
				     Spring beans, and a response field left unmapped stops the build. Naming the processors
				     turns discovery off, so Spring Boot's configuration processor is named too. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
						<annotationProcessorPaths>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-configuration-processor</artifactId>
							</path>
						</annotationProcessorPaths>
						<compilerArgs combine.children="append">
							<arg>-Amapstruct.defaultComponentModel=spring</arg>
							<arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<!-- The API is written as OpenAPI specs (src/main/openapi/*.yaml, one per module that serves
				     requests); each module generates its controllers' interfaces and the JSON classes from
				     its own spec. The page generates its TypeScript side from the same files. -->
				<plugin>
					<groupId>org.openapitools</groupId>
					<artifactId>openapi-generator-maven-plugin</artifactId>
					<version>7.26.0</version>
					<!-- every execution's: the spec and packages are each module's -->
					<configuration>
						<generatorName>spring</generatorName>
						<library>spring-boot</library>
						<generateSupportingFiles>false</generateSupportingFiles>
						<generateApiDocumentation>false</generateApiDocumentation>
						<generateApiTests>false</generateApiTests>
						<generateModelDocumentation>false</generateModelDocumentation>
						<generateModelTests>false</generateModelTests>
						<!-- no suffix: the specs name their schemas …Request (sent), …Response (answered), …Value (enums) -->
						<!-- instants (format date-time) as java.time.Instant -->
						<typeMappings>
							<typeMapping>DateTime=Instant</typeMapping>
						</typeMappings>
						<importMappings>
							<importMapping>Instant=java.time.Instant</importMapping>
						</importMappings>
						<!-- the kernel's shared schemas (gig.yaml) are the kernel's classes, never generated again -->
						<schemaMappings>
							<schemaMapping>ProblemResponse=sk.drabikp.gigsynchub.gig.api.ProblemResponse</schemaMapping>
							<schemaMapping>ProblemCodeValue=sk.drabikp.gigsynchub.gig.api.ProblemCodeValue</schemaMapping>
							<schemaMapping>GigFormRequest=sk.drabikp.gigsynchub.gig.api.GigFormRequest</schemaMapping>
							<schemaMapping>GigFormResponse=sk.drabikp.gigsynchub.gig.api.GigFormResponse</schemaMapping>
							<schemaMapping>CountryValue=sk.drabikp.gigsynchub.gig.api.CountryValue</schemaMapping>
							<schemaMapping>EntryTypeValue=sk.drabikp.gigsynchub.gig.api.EntryTypeValue</schemaMapping>
							<schemaMapping>TimeOfDay=java.lang.String</schemaMapping>
						</schemaMappings>
						<configOptions>
							<useSpringBoot4>true</useSpringBoot4>
							<useJackson3>true</useJackson3>
							<useJakartaEe>true</useJakartaEe>
							<interfaceOnly>true</interfaceOnly>
							<skipDefaultInterface>true</skipDefaultInterface>
							<useTags>true</useTags>
							<requestMappingMode>none</requestMappingMode>
							<openApiNullable>false</openApiNullable>
							<documentationProvider>none</documentationProvider>
							<annotationLibrary>none</annotationLibrary>
							<!-- The limits the specs carry become jakarta.validation annotations on the
							     generated classes and parameters, which spring-boot-starter-validation
							     (app) then enforces: a maxLength or maxItems in a spec is a 400, not a
							     comment. Off until October 2026, which is why some specs had limits
							     nothing checked. -->
							<useBeanValidation>true</useBeanValidation>
							<hideGenerationTimestamp>true</hideGenerationTimestamp>
							<generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
							<generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
						</configOptions>
					</configuration>
					<executions>
						<execution>
							<id>api</id>
							<goals>
								<goal>generate</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
