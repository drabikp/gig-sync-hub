<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>sk.drabik</groupId>
	<artifactId>bzscraper</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>bzscraper</name>
	<description>Gig sync hub: one band's gig catalog, kept in sync with listing platforms.</description>

	<!-- Vertical slices: one module per feature (features/), each with its own domain, application
	     (use cases + ports) and adapters; gig is the shared kernel. Platforms plug into the features'
	     ports (platforms/); app wires everything and runs. -->
	<modules>
		<module>features/gig</module>
		<module>features/accounts</module>
		<module>features/places</module>
		<module>features/sync</module>
		<module>features/catalog</module>
		<module>features/importing</module>
		<module>features/check</module>
		<module>features/calendar</module>
		<module>platforms/browser</module>
		<module>platforms/bandzone</module>
		<module>platforms/bandsintown</module>
		<module>web/live</module>
		<module>web/frontend</module>
		<module>app</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<!-- H2 now only reads the old database's SQL backup for the one-time import into
		     PostgreSQL (bzscraper.db.import-h2); pinned to the version that wrote it. -->
		<h2.version>2.4.240</h2.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<!-- only the app module runs (spring-boot:run) -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-gig</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-gig</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-live</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-frontend</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-accounts</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-accounts</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-places</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-sync</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-sync</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-catalog</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-catalog</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-importing</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-check</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-calendar</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-browser</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-browser</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-bandzone</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>sk.drabik</groupId>
				<artifactId>bzscraper-bandsintown</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>1.4.2</version>
			</dependency>
			<dependency>
				<groupId>org.jsoup</groupId>
				<artifactId>jsoup</artifactId>
				<version>1.22.1</version>
			</dependency>
			<dependency>
				<groupId>com.opencsv</groupId>
				<artifactId>opencsv</artifactId>
				<version>5.12.0</version>
			</dependency>
			<dependency>
				<groupId>org.seleniumhq.selenium</groupId>
				<artifactId>selenium-java</artifactId>
				<version>4.27.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<pluginManagement>
			<plugins>
				<!-- MapStruct writes the mappers between the API's classes and the domain (…Mapper interfaces):
				     Spring beans, and a response field left unmapped stops the build. Naming the processors
				     turns discovery off, so Spring Boot's configuration processor is named too. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
						<annotationProcessorPaths>
							<path>
								<groupId>org.mapstruct</groupId>
								<artifactId>mapstruct-processor</artifactId>
								<version>${mapstruct.version}</version>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-configuration-processor</artifactId>
							</path>
						</annotationProcessorPaths>
						<compilerArgs combine.children="append">
							<arg>-Amapstruct.defaultComponentModel=spring</arg>
							<arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<!-- The API is written as OpenAPI specs (src/main/openapi/*.yaml, one per module that serves
				     requests); each module generates its controllers' interfaces and the JSON classes from
				     its own spec. The page generates its TypeScript side from the same files. -->
				<plugin>
					<groupId>org.openapitools</groupId>
					<artifactId>openapi-generator-maven-plugin</artifactId>
					<version>7.26.0</version>
					<executions>
						<execution>
							<id>api</id>
							<goals>
								<goal>generate</goal>
							</goals>
							<configuration>
								<generatorName>spring</generatorName>
								<library>spring-boot</library>
								<generateSupportingFiles>false</generateSupportingFiles>
								<generateApiDocumentation>false</generateApiDocumentation>
								<generateApiTests>false</generateApiTests>
								<generateModelDocumentation>false</generateModelDocumentation>
								<generateModelTests>false</generateModelTests>
								<!-- no suffix: the specs name their schemas …Request (sent), …Response (answered), …Value (enums) -->
								<!-- instants (format date-time) as java.time.Instant -->
								<typeMappings>
									<typeMapping>DateTime=Instant</typeMapping>
								</typeMappings>
								<importMappings>
									<importMapping>Instant=java.time.Instant</importMapping>
								</importMappings>
								<!-- the kernel's shared schemas (gig.yaml) are the kernel's classes, never generated again -->
								<schemaMappings>
									<schemaMapping>ProblemResponse=sk.drabikp.bzscraper.gig.api.ProblemResponse</schemaMapping>
									<schemaMapping>ProblemCodeValue=sk.drabikp.bzscraper.gig.api.ProblemCodeValue</schemaMapping>
									<schemaMapping>GigFormRequest=sk.drabikp.bzscraper.gig.api.GigFormRequest</schemaMapping>
									<schemaMapping>GigFormResponse=sk.drabikp.bzscraper.gig.api.GigFormResponse</schemaMapping>
									<schemaMapping>CountryValue=sk.drabikp.bzscraper.gig.api.CountryValue</schemaMapping>
									<schemaMapping>EntryTypeValue=sk.drabikp.bzscraper.gig.api.EntryTypeValue</schemaMapping>
									<schemaMapping>TimeOfDay=java.lang.String</schemaMapping>
								</schemaMappings>
								<configOptions>
									<useSpringBoot4>true</useSpringBoot4>
									<useJackson3>true</useJackson3>
									<useJakartaEe>true</useJakartaEe>
									<interfaceOnly>true</interfaceOnly>
									<skipDefaultInterface>true</skipDefaultInterface>
									<useTags>true</useTags>
									<requestMappingMode>none</requestMappingMode>
									<openApiNullable>false</openApiNullable>
									<documentationProvider>none</documentationProvider>
									<annotationLibrary>none</annotationLibrary>
									<useBeanValidation>false</useBeanValidation>
									<hideGenerationTimestamp>true</hideGenerationTimestamp>
									<generateJsonIncludeAnnotations>false</generateJsonIncludeAnnotations>
									<generateJsonSetterNullsAnnotations>false</generateJsonSetterNullsAnnotations>
								</configOptions>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
